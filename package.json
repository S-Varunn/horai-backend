{
  "name": "horai-backend",
  "version": "1.0.0",
  "description": "Horai Backend API — Node.js + PostgreSQL with WhatsApp & Discord AI Assistant",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --config nodemon.json src/app.js",
    "start": "node src/app.js",
    "start:prod": "node src/db/migrate.js && node src/app.js",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/db/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile src/db/knexfile.js",
    "seed": "knex seed:run --knexfile src/db/knexfile.js",
    "test": "jest"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
